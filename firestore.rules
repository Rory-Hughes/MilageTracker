rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if owns(uid);
      allow write: if false;

      match /syncRecords/{recordId} {
        allow read: if owns(uid);
        allow write: if false;
      }

      match /{document=**} {
        allow read: if owns(uid);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
